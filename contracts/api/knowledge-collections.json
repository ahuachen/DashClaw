{
  "domain": "knowledge-collections",
  "route_root": "app/api/knowledge/collections",
  "routes": [
    {
      "file": "app/api/knowledge/collections/route.js",
      "path": "/api/knowledge/collections",
      "methods": ["GET", "POST"]
    },
    {
      "file": "app/api/knowledge/collections/[collectionId]/route.js",
      "path": "/api/knowledge/collections/[collectionId]",
      "methods": ["GET", "PATCH"]
    },
    {
      "file": "app/api/knowledge/collections/[collectionId]/items/route.js",
      "path": "/api/knowledge/collections/[collectionId]/items",
      "methods": ["GET", "POST"]
    },
    {
      "file": "app/api/knowledge/collections/[collectionId]/sync/route.js",
      "path": "/api/knowledge/collections/[collectionId]/sync",
      "methods": ["POST"]
    },
    {
      "file": "app/api/knowledge/collections/[collectionId]/search/route.js",
      "path": "/api/knowledge/collections/[collectionId]/search",
      "methods": ["POST"]
    }
  ]
}
