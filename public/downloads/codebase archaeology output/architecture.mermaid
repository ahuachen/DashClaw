graph TD
    subgraph Clients["Clients"]
        SDK_JS["Node.js SDK\n(178+ methods)"]
        SDK_PY["Python SDK\n(urllib, zero deps)"]
        BROWSER["Browser UI\n(NextAuth cookie)"]
        AGENT_TOOLS["agent-tools/\nPython CLI suite"]
    end

    subgraph Edge["Edge: middleware.js"]
        MW["Auth + Rate Limit\n+ CORS + Header Inject"]
        DEMO_PROXY["Demo Fixture\nProxy (DASHCLAW_MODE=demo)"]
    end

    subgraph AppLayer["Next.js 15 App Router (app/)"]
        PAGES["UI Pages\n(30+ routes)"]
        API["API Routes\n(/api/* — 50+ dirs)"]

        subgraph LibCore["Core Libraries (app/lib/)"]
            GUARD["guard.js\nPolicy Engine"]
            SIGNALS["signals.js\nRisk Signal Compute"]
            LLM["llm.js\nOpenAI/Anthropic/Google"]
            EVAL["eval.js\nScorer Engine"]
            SECURITY["security.js\nDLP Scanner"]
            AUDIT["audit.js\nFire-and-forget Logging"]
            WEBHOOKS["webhooks.js\nHMAC Delivery"]
            EVENTS["events.js\nSSE Broker (Redis/In-memory)"]
            SCORING["scoringProfiles.js\nRule-based Math Engine"]
            LEARNING["learningAnalytics.js\nVelocity + Maturity"]
            ENCRYPT["encryption.js\nAES-256-GCM (AEAD)"]
        end

        subgraph Repos["Repository Layer (app/lib/repositories/)"]
            REPO["22 repositories\n(strict SQL isolation)"]
        end
    end

    subgraph DataLayer["Data Layer"]
        NEON["Neon Postgres\n(serverless)"]
        LOCAL_PG["Local Postgres\n(Docker / TCP)"]
        REDIS["Redis / Upstash\n(SSE pub-sub, optional)"]
        SQLITE["SQLite\n(agent-tools local)"]
    end

    subgraph Externals["External Services"]
        OAUTH["GitHub / Google / OIDC\nOAuth Providers"]
        LLM_EXT["OpenAI / Anthropic\nLLM APIs"]
        RESEND["Resend\nEmail Alerts"]
        STRIPE["Stripe\nBilling"]
        CRON["External Scheduler\n(GitHub Actions / cron)"]
    end

    subgraph SDKs["Published Packages"]
        NPM["npm: dashclaw\nv2.0.3"]
        PYPI["PyPI: dashclaw\nPython"]
    end

    SDK_JS -->|x-api-key header| Edge
    SDK_PY -->|x-api-key header| Edge
    BROWSER -->|NextAuth cookie / Sec-Fetch-Site| Edge
    AGENT_TOOLS -->|x-api-key header| Edge

    MW --> DEMO_PROXY
    MW -->|Injects x-org-id, x-org-role| AppLayer

    PAGES --> LibCore
    API --> LibCore
    API --> Repos

    LibCore --> Repos
    Repos --> NEON
    Repos --> LOCAL_PG
    EVENTS --> REDIS

    GUARD --> LLM
    EVAL --> LLM
    LLM --> LLM_EXT

    WEBHOOKS --> RESEND
    AUDIT --> NEON

    OAUTH -->|callbacks| AppLayer
    CRON -->|Bearer CRON_SECRET| API

    SDK_JS --- NPM
    SDK_PY --- PYPI

    AGENT_TOOLS --> SQLITE

