{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    [
      "@swarmxai_guardrails/opencode-plugin",
      {
        "behaviorSecurity": {
          "baseUrl": "http://localhost:3310",
          "apiKey": "${BEHAVIOR_SECURITY_API_KEY}",
          "agentId": "opencode-local",
          "agentName": "OpenCode (local dev)",
          "failClosed": true,
          "riskScoreDefault": 50,
          "highRiskTools": ["bash", "write", "patch"],
          "ignoredTools": ["read", "glob", "grep"],
          "approvalTimeoutMs": 300000
        },
        "modelSafety": {
          "provider": "llamaguard",
          "endpoint": "${MODEL_SAFETY_ENDPOINT}",
          "apiKey": "${MODEL_SAFETY_API_KEY}",
          "checkInput": true,
          "checkOutput": true,
          "failClosed": false,
          "categories": []
        }
      }
    ]
  ]
}
