{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "node scripts/auto-migrate.mjs && next build",
  "crons": [
    {
      "path": "/api/cron/signals",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/integration-health",
      "schedule": "0 */6 * * *"
    }
  ]
}
