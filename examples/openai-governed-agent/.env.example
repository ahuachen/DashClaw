# DashClaw Connection — point at your instance (local or deployed)
DASHCLAW_BASE_URL=http://localhost:3000
# DASHCLAW_BASE_URL=https://your-dashclaw.vercel.app
DASHCLAW_API_KEY=your_dashclaw_api_key

# OpenAI — leave at sk-fake-key to run the example in simulated mode
# (no real API call is made; the agent uses canned reasoning instead)
OPENAI_API_KEY=sk-fake-key